# ===========================================
# Mama Math - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control!

# ── Supabase (Required) ────────────────────
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── Infobip (SMS / WhatsApp signup verification) ──
# Prefer a local-only file: copy this block into `supabase/.env` (gitignored). Do not commit it.
# Deploy to Supabase: `supabase link` then `supabase secrets set --env-file supabase/.env`
# Keys (never use VITE_* — Infobip stays server-side):
#   INFOBIP_BASE_URL=your-subdomain.api.infobip.com
#   INFOBIP_API_KEY=key-without-App-prefix
#   INFOBIP_SMS_FROM=14195761116
#   INFOBIP_SMS_RECOVERY_FROM=MamaReset    # Alphanumeric sender for password-reset SMS (max 11 chars)
#   INFOBIP_WHATSAPP_FROM=14195761116
#   SIGNUP_OTP_PEPPER=long-random-string

# ── ElevenLabs (server-only — spoken feedback on student analysis) ──
# Never put this in VITE_* . Set on Supabase for the Edge Function:
#   supabase secrets set ELEVENLABS_API_KEY=sk_...
# Optional overrides:
#   ELEVENLABS_VOICE_ID=PEyWCmLPt74vpHWLv3Fo
#   ELEVENLABS_MODEL_ID=eleven_v3
# Local testing: add the same vars to supabase/.env (gitignored) and `supabase functions serve`

# ── OpenRouter AI (Required for AI Features) ──
# Get your API key from: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
VITE_OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# ── Vapi Voice AI (Optional) ───────────────
# Get your API key from: https://vapi.ai/
VITE_VAPI_API_KEY=your-vapi-api-key-here

# ── Partner Monitor (Read-only monitoring dashboard) ──
# Shared access code that implementing partners type in at /monitor/login.
# Rotate this value before sharing the URL with a new partner.
# If unset, a default fallback is used — do NOT ship with the default.
VITE_MONITOR_PASSWORD=change-me-before-sharing

# ── Firebase (Optional - for Cloud Functions) ──
# Only needed if using Firebase Cloud Functions
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
