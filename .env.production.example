# Copy to .env before running: npm run build:hostinger
# Vite reads these at BUILD time — they are embedded in the JS bundle.

# Your live site (for your notes; used in docs / optional tooling)
VITE_SITE_URL=https://yourdomain.com

# Required — Supabase project (Dashboard → Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Partner monitor (/monitor) — use strong values in production
VITE_MONITOR_EMAIL=you@yourdomain.com
VITE_MONITOR_PASSWORD=use-a-long-random-password

# OpenRouter: do NOT set a VITE_ key in production.
# Deploy supabase/functions/openrouter-proxy and set OPENROUTER_API_KEY as a Supabase secret.

# Optional
# VITE_VAPI_API_KEY=
